<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ishtaran</groupId>
    <artifactId>ishtaran-java</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Ishtaran Java SDK</name>
    <description>Official Java SDK for the Ishtaran programmable financial platform API.</description>
    <url>https://ishtaran.com</url>

    <!--
        Licença: decisão de projeto ainda não tomada (ver SDK_CAPABILITY_SPEC.md §16 e
        docs/product-definition/16-DECISION-LOG.md — nenhuma entrada de licença de software
        existe hoje). Placeholder explícito, nunca assumido como open-source silenciosamente.
        Bloqueia publicação externa (Maven Central), não bloqueia build/uso interno.
    -->
    <licenses>
        <license>
            <name>UNLICENSED — pending project decision, see SDK_CAPABILITY_SPEC.md §16</name>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/ishtaran/ishtaran-java</url>
        <connection>scm:git:https://github.com/ishtaran/ishtaran-java.git</connection>
        <developerConnection>scm:git:https://github.com/ishtaran/ishtaran-java.git</developerConnection>
    </scm>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jackson.version>2.17.2</jackson.version>
        <slf4j.version>2.0.16</slf4j.version>
        <junit.version>5.11.0</junit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <!-- test-only -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals><goal>jar-no-fork</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.8.0</version>
                <configuration>
                    <doclint>none</doclint>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals><goal>jar</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!--
        Publicação real (Maven Central via Central Publishing Portal, assinatura GPG) fica
        preparada mas NUNCA executada sem autorização explícita do usuário — ver
        JAVA_SDK_IMPLEMENTATION_PLAN.md §11 e a regra correspondente do brief do SDK Program.
        <distributionManagement>/<profiles> de release ficam para quando essa autorização existir.
    -->
</project>
