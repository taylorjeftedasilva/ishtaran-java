<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ishtaran</groupId>
    <artifactId>ishtaran-java</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Ishtaran Java SDK</name>
    <description>Official Java SDK for the Ishtaran programmable financial platform API.</description>
    <url>https://ishtaran.com</url>

    <!--
        License: project decision not yet made (see SDK_CAPABILITY_SPEC.md §16 and
        docs/product-definition/16-DECISION-LOG.md — no software license entry exists
        today). Explicit placeholder, never silently assumed as open-source.
        Blocks external publication (Maven Central), does not block internal build/use.
    -->
    <licenses>
        <license>
            <name>UNLICENSED — pending project decision, see SDK_CAPABILITY_SPEC.md §16</name>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/ishtaran/ishtaran-java</url>
        <connection>scm:git:https://github.com/ishtaran/ishtaran-java.git</connection>
        <developerConnection>scm:git:https://github.com/ishtaran/ishtaran-java.git</developerConnection>
    </scm>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jackson.version>2.18.8</jackson.version>
        <slf4j.version>2.0.16</slf4j.version>
        <junit.version>5.11.0</junit.version>
        <bitcoinj.version>0.17.1</bitcoinj.version>
        <bouncycastle.version>1.84</bouncycastle.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <!--
            SDK Self-Custody Support (SPEC-018/019/020, Java-equivalent of TDR-017) — BIP32/BIP39/BIP44
            derivation (public AND private key locally, never sent to Ishtaran,
            INV-SC-01) and ECDSA/secp256k1 signing. bitcoinj is the de facto standard in the Java
            ecosystem for this math (the same role NBitcoin plays in .NET, TDR-017) — it already
            depends on Bouncy Castle internally for elliptic curve operations.
        -->
        <dependency>
            <groupId>org.bitcoinj</groupId>
            <artifactId>bitcoinj-core</artifactId>
            <version>${bitcoinj.version}</version>
        </dependency>
        <!-- Real Keccak-256 (Tron/Ethereum), different from the NIST-finalized SHA3-256; .NET/JDK don't have this built in; same choice as TDR-017. -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>${bouncycastle.version}</version>
        </dependency>
        <!-- Explicit pin, not just a transitive dependency of bitcoinj-core: without this, Maven
             resolves bcprov-jdk15to18 to whatever version bitcoinj-core's own POM declares, which
             has lagged behind real CVE fixes (CVE-2025-14813, CRITICAL), since an explicit direct
             dependency always wins over a transitive one in Maven's resolution. -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk15to18</artifactId>
            <version>${bouncycastle.version}</version>
        </dependency>

        <!-- test-only -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals><goal>jar-no-fork</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.8.0</version>
                <configuration>
                    <doclint>none</doclint>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals><goal>jar</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!--
        Real publication (Maven Central via the Central Publishing Portal, GPG signing) is kept
        prepared but NEVER executed without explicit user authorization — see
        JAVA_SDK_IMPLEMENTATION_PLAN.md §11 and the corresponding rule in the SDK Program brief.
        Release <distributionManagement>/<profiles> are left for when that authorization exists.
    -->
</project>
